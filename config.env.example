# Copier ce fichier en "config.env" (a la racine du projet) et adapter les
# valeurs. config.env est ignore par git (voir .gitignore) : les vraies
# valeurs ne sont donc jamais commitees.
#
# Une variable d'environnement deja definie avant le lancement du
# webservice reste prioritaire sur ce fichier.

# Relai SMTP interne sans authentification (cas le plus courant) :
SMTP_HOST=relai-smtp.monentreprise.local
SMTP_FROM=service@monentreprise.com

# Options avancees (decommenter/adapter si besoin) :
# SMTP_PORT=25
# SMTP_USE_TLS=false
# SMTP_USER=
# SMTP_PASSWORD=
